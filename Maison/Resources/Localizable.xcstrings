      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journée en bref"
          }
        }
      }
    },
    "Your Home Assistant account decides what you can change on the server; your role in the household decides who you can invite.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte Home Assistant décide de ce que vous pouvez modifier sur le serveur ; votre rôle dans le foyer, de qui vous pouvez inviter."
          }
        }
      }
    },
    "Your Home Assistant, as simple as the Home app. We take care of almost everything.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Home Assistant, aussi simple que l’app Maison. On s’occupe de presque tout."
          }
        }
      }
    },
