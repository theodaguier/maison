// Copy to Config/Secrets.xcconfig (gitignored).
// PostHog → Project Settings → Project API key, on the EU project.
// The app sends only to https://eu.i.posthog.com.
// Use the project token (phc_…). Never a personal key (phx_…).

POSTHOG_API_KEY = phc_your_project_key

// Maison's relay, for the grid operators' readings. In an xcconfig, "//" starts a comment:
// write the address as https:/$()/relay.example.com
MAISON_RELAY_URL =
